<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="jackal_navigation_world">
    <!-- Indoor warehouse, 12 m by 10 m interior.
         Interior spans x = -2..10 and y = -5..5.
         Spawn (0, 0) and the goal at (4, 0) stay in open floor.
         The robot is spawned by jackal_demo_sim.launch.py, not by this file. -->
    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.15 0.16 0.18 1</background>
    </scene>
    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libignition-gazebo-imu-system.so" name="ignition::gazebo::systems::Imu"/>
    <plugin filename="libignition-gazebo-navsat-system.so" name="ignition::gazebo::systems::NavSat"/>
    <plugin filename="libignition-gazebo-contact-system.so" name="ignition::gazebo::systems::Contact"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.55 0.55 0.55 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>-0.3 -0.2 -1</direction>
    </light>
    <light type="point" name="ceiling_west">
      <pose>2.0 0.0 3.4 0 0 0</pose>
      <diffuse>0.7 0.68 0.6 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>14</range>
        <constant>0.35</constant>
        <linear>0.04</linear>
        <quadratic>0.008</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
    <light type="point" name="ceiling_east">
      <pose>7.2 0.5 3.4 0 0 0</pose>
      <diffuse>0.7 0.68 0.6 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>14</range>
        <constant>0.35</constant>
        <linear>0.04</linear>
        <quadratic>0.008</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><ode><kp>100000.0</kp><kd>1.0</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.42 0.42 0.44 1</ambient>
            <diffuse>0.42 0.42 0.44 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>4.0 5.10 1.20 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12.40 0.20 2.40</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
            <contact><ode><kp>100000.0</kp><kd>1.0</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.40 0.20 2.40</size></box></geometry>
          <material>
            <ambient>0.62 0.60 0.56 1</ambient>
            <diffuse>0.62 0.60 0.56 1</diffuse>
          </material>
        </visual>
        <sensor name="wall_north_contact" type="contact">
          <contact>
            <collision>collision</collision>
            <topic>/jackal_rl/obstacle_contacts</topic>
          </contact>
          <always_on>true</always_on>
          <update_rate>100</update_rate>
        </sensor>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>4.0 -5.10 1.20 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12.40 0.20 2.40</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
            <contact><ode><kp>100000.0</kp><kd>1.0</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.40 0.20 2.40</size></box></geometry>
          <material>
            <ambient>0.62 0.60 0.56 1</ambient>
            <diffuse>0.62 0.60 0.56 1</diffuse>
          </material>
        </visual>
        <sensor name="wall_south_contact" type="contact">
          <contact>
            <collision>collision</collision>
            <topic>/jackal_rl/obstacle_contacts</topic>
          </contact>
          <always_on>true</always_on>
          <update_rate>100</update_rate>
        </sensor>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>10.10 0.0 1.20 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.20 10.40 2.40</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
            <contact><ode><kp>100000.0</kp><kd>1.0</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.20 10.40 2.40</size></box></geometry>
          <material>
            <ambient>0.62 0.60 0.56 1</ambient>
            <diffuse>0.62 0.60 0.56 1</diffuse>
          </material>
        </visual>
        <sensor name="wall_east_contact" type="contact">
          <contact>
            <collision>collision</collision>
            <topic>/jackal_rl/obstacle_contacts</topic>
          </contact>
          <always_on>true</always_on>
          <update_rate>100</update_rate>
        </sensor>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-2.10 0.0 1.20 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.20 10.40 2.40</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
            <contact><ode><kp>100000.0</kp><kd>1.0</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.20 10.40 2.40</size></box></geometry>
          <material>
            <ambient>0.62 0.60 0.56 1</ambient>
            <diffuse>0.62 0.60 0.56 1</diffuse>
          </material>
        </visual>
        <sensor name="wall_west_contact" type="contact">
          <contact>
            <collision>collision</collision>
            <topic>/jackal_rl/obstacle_contacts</topic>
          </contact>
          <always_on>true</always_on>
          <update_rate>100</update_rate>
        </sensor>
      </link>
    </model>

    <!-- Corridor along the start-goal line. Inner faces at y = +/- 2.07 m. -->
    <model name="corridor_north">
      <static>true</static>
      <pose>3.45 2.15 0.60 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.90 0.16 1.20</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
            <contact><ode><kp>100000.0</kp><kd>1.0</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.90 0.16 1.20</size></box></geometry>
          <material>
            <ambient>0.32 0.36 0.42 1</ambient>
            <diffuse>0.32 0.36 0.42 1</diffuse>
          </material>
        </visual>
        <sensor name="corridor_north_contact" type="contact">
          <contact>
            <collision>collision</collision>
            <topic>/jackal_rl/obstacle_contacts</topic>
          </contact>
          <always_on>true</always_on>
          <update_rate>100</update_rate>
        </sensor>
      </link>
    </model>

    <model name="corridor_south">
      <static>true</static>
      <pose>3.45 -2.15 0.60 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.90 0.16 1.20</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
            <contact><ode><kp>100000.0</kp><kd>1.0</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.90 0.16 1.20</size></box></geometry>
          <material>
            <ambient>0.32 0.36 0.42 1</ambient>
            <diffuse>0.32 0.36 0.42 1</diffuse>
          </material>
        </visual>
        <sensor name="corridor_south_contact" type="contact">
          <contact>
            <collision>collision</collision>
            <topic>/jackal_rl/obstacle_contacts</topic>
          </contact>
          <always_on>true</always_on>
          <update_rate>100</update_rate>
        </sensor>
      </link>
    </model>

    <!-- Offset crate. The y = 0 line stays open; the north side is the alternate route. -->
    <model name="crate_offset">
      <static>true</static>
      <pose>2.70 0.85 0.50 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.70 0.55 1.00</size></box></geometry>
          <surface>
            <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
            <contact><ode><kp>100000.0</kp><kd>1.0</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.70 0.55 1.00</size></box></geometry>
          <material>
            <ambient>0.72 0.42 0.16 1</ambient>
            <diffuse>0.72 0.42 0.16 1</diffuse>
          </material>
        </visual>
        <sensor name="crate_offset_contact" type="contact">
          <contact>
            <collision>collision</collision>
            <topic>/jackal_rl/obstacle_contacts</topic>
          </contact>
          <always_on>true</always_on>
          <update_rate>100</update_rate>
        </sensor>
      </link>
    </model>

    <!-- Parallel shelves. The 1.00 m gap between them is the narrow passage. -->
    <model name="shelf_north">
      <static>true</static>
      <pose>6.80 3.35 0.60 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.40 0.30 1.20</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
            <contact><ode><kp>100000.0</kp><kd>1.0</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.40 0.30 1.20</size></box></geometry>
          <material>
            <ambient>0.22 0.32 0.55 1</ambient>
            <diffuse>0.22 0.32 0.55 1</diffuse>
          </material>
        </visual>
        <sensor name="shelf_north_contact" type="contact">
          <contact>
            <collision>collision</collision>
            <topic>/jackal_rl/obstacle_contacts</topic>
          </contact>
          <always_on>true</always_on>
          <update_rate>100</update_rate>
        </sensor>
      </link>
    </model>

    <model name="shelf_south">
      <static>true</static>
      <pose>6.80 2.05 0.60 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.40 0.30 1.20</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
            <contact><ode><kp>100000.0</kp><kd>1.0</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.40 0.30 1.20</size></box></geometry>
          <material>
            <ambient>0.22 0.32 0.55 1</ambient>
            <diffuse>0.22 0.32 0.55 1</diffuse>
          </material>
        </visual>
        <sensor name="shelf_south_contact" type="contact">
          <contact>
            <collision>collision</collision>
            <topic>/jackal_rl/obstacle_contacts</topic>
          </contact>
          <always_on>true</always_on>
          <update_rate>100</update_rate>
        </sensor>
      </link>
    </model>

    <model name="crate_southwest">
      <static>true</static>
      <pose>-0.20 -3.70 0.40 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.70 0.55 0.80</size></box></geometry>
          <surface>
            <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
            <contact><ode><kp>100000.0</kp><kd>1.0</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.70 0.55 0.80</size></box></geometry>
          <material>
            <ambient>0.55 0.34 0.16 1</ambient>
            <diffuse>0.55 0.34 0.16 1</diffuse>
          </material>
        </visual>
        <sensor name="crate_southwest_contact" type="contact">
          <contact>
            <collision>collision</collision>
            <topic>/jackal_rl/obstacle_contacts</topic>
          </contact>
          <always_on>true</always_on>
          <update_rate>100</update_rate>
        </sensor>
      </link>
    </model>

    <model name="pallet_east">
      <static>true</static>
      <pose>8.70 -0.40 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.10 0.70 0.70</size></box></geometry>
          <surface>
            <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
            <contact><ode><kp>100000.0</kp><kd>1.0</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.10 0.70 0.70</size></box></geometry>
          <material>
            <ambient>0.48 0.30 0.14 1</ambient>
            <diffuse>0.48 0.30 0.14 1</diffuse>
          </material>
        </visual>
        <sensor name="pallet_east_contact" type="contact">
          <contact>
            <collision>collision</collision>
            <topic>/jackal_rl/obstacle_contacts</topic>
          </contact>
          <always_on>true</always_on>
          <update_rate>100</update_rate>
        </sensor>
      </link>
    </model>

    <model name="crate_southeast">
      <static>true</static>
      <pose>8.80 -3.60 0.50 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.80 0.80 1.00</size></box></geometry>
          <surface>
            <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
            <contact><ode><kp>100000.0</kp><kd>1.0</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.80 0.80 1.00</size></box></geometry>
          <material>
            <ambient>0.62 0.48 0.20 1</ambient>
            <diffuse>0.62 0.48 0.20 1</diffuse>
          </material>
        </visual>
        <sensor name="crate_southeast_contact" type="contact">
          <contact>
            <collision>collision</collision>
            <topic>/jackal_rl/obstacle_contacts</topic>
          </contact>
          <always_on>true</always_on>
          <update_rate>100</update_rate>
        </sensor>
      </link>
    </model>

    <model name="column_a">
      <static>true</static>
      <pose>1.80 -3.40 0.65 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.30</radius><length>1.30</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
            <contact><ode><kp>100000.0</kp><kd>1.0</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.30</radius><length>1.30</length></cylinder></geometry>
          <material>
            <ambient>0.72 0.72 0.75 1</ambient>
            <diffuse>0.72 0.72 0.75 1</diffuse>
          </material>
        </visual>
        <sensor name="column_a_contact" type="contact">
          <contact>
            <collision>collision</collision>
            <topic>/jackal_rl/obstacle_contacts</topic>
          </contact>
          <always_on>true</always_on>
          <update_rate>100</update_rate>
        </sensor>
      </link>
    </model>

    <model name="column_b">
      <static>true</static>
      <pose>5.80 -3.10 0.70 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.32</radius><length>1.40</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
            <contact><ode><kp>100000.0</kp><kd>1.0</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.32</radius><length>1.40</length></cylinder></geometry>
          <material>
            <ambient>0.72 0.72 0.75 1</ambient>
            <diffuse>0.72 0.72 0.75 1</diffuse>
          </material>
        </visual>
        <sensor name="column_b_contact" type="contact">
          <contact>
            <collision>collision</collision>
            <topic>/jackal_rl/obstacle_contacts</topic>
          </contact>
          <always_on>true</always_on>
          <update_rate>100</update_rate>
        </sensor>
      </link>
    </model>

    <model name="column_c">
      <static>true</static>
      <pose>8.40 1.70 0.60 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>1.20</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
            <contact><ode><kp>100000.0</kp><kd>1.0</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>1.20</length></cylinder></geometry>
          <material>
            <ambient>0.72 0.72 0.75 1</ambient>
            <diffuse>0.72 0.72 0.75 1</diffuse>
          </material>
        </visual>
        <sensor name="column_c_contact" type="contact">
          <contact>
            <collision>collision</collision>
            <topic>/jackal_rl/obstacle_contacts</topic>
          </contact>
          <always_on>true</always_on>
          <update_rate>100</update_rate>
        </sensor>
      </link>
    </model>

    <model name="goal_marker">
      <static>true</static>
      <pose>4.0 0.0 0.02 0 0 0</pose>
      <link name="marker_link">
        <visual name="visual">
          <geometry><cylinder><radius>0.15</radius><length>0.04</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.7 0.2 1</ambient>
            <diffuse>0.1 0.8 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
