<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="jackal_demo_unseen">
    <gravity>0 0 -9.81</gravity>
    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libignition-gazebo-imu-system.so" name="ignition::gazebo::systems::Imu"/>
    <plugin filename="libignition-gazebo-navsat-system.so" name="ignition::gazebo::systems::NavSat"/>
    <plugin filename="libignition-gazebo-contact-system.so" name="ignition::gazebo::systems::Contact"/>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 -0.5 -1</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.62 0.62 0.62 1</ambient><diffuse>0.62 0.62 0.62 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="obstacle_a">
      <static>true</static>
      <pose>1.6 0.9 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.45 0.45 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.45 0.45 0.5</size></box></geometry>
          <material><ambient>0.75 0.22 0.18 1</ambient><diffuse>0.75 0.22 0.18 1</diffuse></material>
        </visual>
        <sensor name="obstacle_a_contact" type="contact">
          <contact>
            <collision>collision</collision>
            <topic>/jackal_rl/obstacle_contacts</topic>
          </contact>
          <always_on>true</always_on>
          <update_rate>100</update_rate>
        </sensor>
      </link>
    </model>
    <model name="obstacle_b">
      <static>true</static>
      <pose>2.9 -0.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.45 0.45 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.45 0.45 0.5</size></box></geometry>
          <material><ambient>0.75 0.22 0.18 1</ambient><diffuse>0.75 0.22 0.18 1</diffuse></material>
        </visual>
        <sensor name="obstacle_b_contact" type="contact">
          <contact>
            <collision>collision</collision>
            <topic>/jackal_rl/obstacle_contacts</topic>
          </contact>
          <always_on>true</always_on>
          <update_rate>100</update_rate>
        </sensor>
      </link>
    </model>
    <model name="obstacle_c">
      <static>true</static>
      <pose>4.2 0.8 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.45 0.45 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.45 0.45 0.5</size></box></geometry>
          <material><ambient>0.75 0.22 0.18 1</ambient><diffuse>0.75 0.22 0.18 1</diffuse></material>
        </visual>
        <sensor name="obstacle_c_contact" type="contact">
          <contact>
            <collision>collision</collision>
            <topic>/jackal_rl/obstacle_contacts</topic>
          </contact>
          <always_on>true</always_on>
          <update_rate>100</update_rate>
        </sensor>
      </link>
    </model>
    <model name="goal_marker">
      <static>true</static>
      <pose>5.2 -1.2 0.02 0 0 0</pose>
      <link name="marker_link">
        <visual name="visual">
          <geometry><cylinder><radius>0.12</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.1 0.7 0.2 1</ambient><diffuse>0.1 0.8 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
