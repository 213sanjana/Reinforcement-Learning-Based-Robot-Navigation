<?xml version="1.0" ?>
<sdf version="1.8">
  <!-- Obstacle course. Not the checkpoint world industrial-warehouse. -->
  <world name="jackal_obstacle_warehouse">
    <gravity>0 0 -9.81</gravity>
    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics" />
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands" />
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster" />
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libignition-gazebo-imu-system.so" name="ignition::gazebo::systems::Imu" />
    <plugin filename="libignition-gazebo-navsat-system.so" name="ignition::gazebo::systems::NavSat" />
    <plugin filename="libignition-gazebo-contact-system.so" name="ignition::gazebo::systems::Contact" />
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>6 0 12 0 0 0</pose>
      <diffuse>0.85 0.84 0.8 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>0.2 0.1 -1</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>80 80</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>80 80</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.42 0.42 0.40 1</ambient>
            <diffuse>0.42 0.42 0.40 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-1 0 1.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 10.2 2.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 10.2 2.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.62 0.62 0.58 1</ambient>
            <diffuse>0.72 0.72 0.68 1</diffuse>
          </material>
        </visual>
        <sensor name="contact" type="contact">
          <contact>
            <collision>collision</collision>
            <topic>/jackal_rl/obstacle_contacts</topic>
          </contact>
          <always_on>true</always_on>
          <update_rate>50</update_rate>
        </sensor>
      </link>
    </model>
