<?xml version="1.0" encoding="utf-8"?>
<!-- AWS RoboMaker no-roof small warehouse.
     Source: https://github.com/aws-robotics/aws-robomaker-small-warehouse-world
     branch ros1, worlds/no_roof_small_warehouse.world. License: MIT, Amazon.com.
     This is the yellow-shelf room in that project's warehouse picture.
     Models are the copies already stored under worlds/external_warehouse/models.
     Fortress plugins and brighter scene light were added. Poses are unchanged.
     This file does not follow the checkpoint route and is not industrial-warehouse.
     The GPL dynamic_logistics_warehouse repository was not copied. -->
<sdf version="1.9">
  <world name="jackal_small_warehouse">
    <gravity>0 0 -9.8</gravity>
    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics" />
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands" />
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster" />
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libignition-gazebo-imu-system.so" name="ignition::gazebo::systems::Imu" />
    <plugin filename="libignition-gazebo-navsat-system.so" name="ignition::gazebo::systems::NavSat" />
    <plugin filename="libignition-gazebo-contact-system.so" name="ignition::gazebo::systems::Contact" />
    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.85 0.86 0.88 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>
    <physics default="0" name="default_physics" type="ode">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>
    <model name="aws_robomaker_warehouse_ShelfF_01_001">
      <include>
        <uri>model://aws_robomaker_warehouse_ShelfF_01</uri>
      </include>
      <pose>-5.795143 -0.956635 0 0 0 0</pose>
    </model>
    <model name="aws_robomaker_warehouse_WallB_01_001">
      <include>
        <uri>model://aws_robomaker_warehouse_WallB_01</uri>
      </include>
      <pose>0.0 0.0 0 0 0 0</pose>
    </model>
    <model name="aws_robomaker_warehouse_ShelfE_01_001">
